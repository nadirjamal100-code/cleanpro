{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1, "newProjectRoot": "projects",
  "projects": { "cleanpro": {
    "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
    "architect": {
      "build": { "builder": "@angular/build:application",
        "options": { "outputPath": "dist/cleanpro", "index": "src/index.html", "browser": "src/main.ts",
          "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "inlineStyleLanguage": "scss",
          "assets": [{ "glob": "**/*", "input": "src/assets", "output": "assets" }, "src/favicon.svg"],
          "styles": ["src/styles.scss"] },
        "configurations": {
          "production": { "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1.5MB" }], "outputHashing": "all" },
          "development": { "optimization": false, "extractLicenses": false, "sourceMap": true } },
        "defaultConfiguration": "production" },
      "serve": { "builder": "@angular/build:dev-server",
        "configurations": { "production": { "buildTarget": "cleanpro:build:production" }, "development": { "buildTarget": "cleanpro:build:development" } },
        "defaultConfiguration": "development"
      }
    }
  }
},
"cli": {
  "analytics": false
}
}
